<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/workoutListFragment">

    <fragment
        android:id="@+id/workoutListFragment"
        android:name="com.cortlandwalker.semaphore.features.workoutlist.WorkoutListFragment"
        android:label="WorkoutListFragment" >
        <action
            android:id="@+id/action_workoutListFragment_to_upsertWorkoutFragment"
            app:destination="@id/upsertWorkoutFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_workoutListFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app.popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/upsertWorkoutFragment"
        android:name="com.cortlandwalker.semaphore.features.upsert.UpsertWorkoutFragment"
        android:label="UpsertWorkoutFragment" >
        <argument
            android:name="workoutId"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.cortlandwalker.semaphore.features.settings.SettingsFragment"
        android:label="SettingsFragment" >
        <action
            android:id="@+id/action_settings_to_markdown"
            app:destination="@id/markdownViewerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_settings_to_analytics"
            app:destination="@id/analyticsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/markdownViewerFragment"
        android:name="com.cortlandwalker.semaphore.features.markdown.MarkdownViewerFragment"
        android:label="MarkdownViewerFragment">
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="filename"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.cortlandwalker.semaphore.features.analytics.AnalyticsFragment"
        android:label="AnalyticsFragment" />

</navigation>